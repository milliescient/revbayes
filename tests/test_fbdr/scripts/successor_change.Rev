# On a sampled (extended=FALSE) dnFBDSP tree, a sampled ancestor's named successor changed species at least once
# on its path. Once an event accessor exists, the first change is a latent, read here from a tree annotation:
# it is that branch's observed event, and hidden events count only below it. The path here runs from t5's
# sample at 6 through a budding at 5 to t4's first appearance at 3. Every line printed must be TRUE.
taxa <- readTaxonData("data/fbdsp_successor.tsv")
trees <- readTrees("data/fbdsp_successor.tre", treetype="clock")
out = "output/successor_change.txt"

x ~ dnFBDSP(taxa=taxa, lambda=0.8, mu=0.3, psi=0.5, rho=1.0, lambda_a=0.2, beta=0.4,
            origin=10.0, condition="time", extended=FALSE)
rec ~ dnFossilRecord(ranges=x, reporting="complete")
rec.clamp(taxa)

# branch 6 runs from 6 to the budding at 5, branch 3 from there to t4
x.setValue(trees[1])
ha <- x.getHiddenAnageneses()
oa <- x.getObservedAnageneses()
print(filename=out, "an anagenesis at 5.5 is the upper branch's event, with lambda_a over the span below it:\n")
print(filename=out, append=TRUE, oa[6] == 1 && abs(ha[6] - 0.1) < 1E-12 && abs(ha[3] - 0.4) < 1E-12, "\n")

x.setValue(trees[2])
ha <- x.getHiddenAnageneses()
hb <- x.getHiddenBuddings()
os <- x.getObservedBifurcations()
print(filename=out, append=TRUE, "a symmetric change at 4 is the lower branch's event, and the upper branch hides none:\n")
print(filename=out, append=TRUE, os[3] == 1 && ha[6] == 0 && hb[6] == 0 && abs(ha[3] - 0.2) < 1E-12, "\n")

x.setValue(trees[3])
ob <- x.getObservedBuddings()
print(filename=out, append=TRUE, "a budding at 5.5 is the upper branch's event:\n")
print(filename=out, append=TRUE, ob[6] == 1 && ob[3] == 0, "\n")

# A chain resumes where it stopped, its first changes included. Its first resumed generation moves z, which no
# term reads, so it logs the state the checkpoint holds.
print(filename=out, append=TRUE, "a checkpoint keeps the first changes:\n")
x.setValue(trees[1])
hb := x.getHiddenBuddings()
ob := x.getObservedBuddings()
os := x.getObservedBifurcations()
oa := x.getObservedAnageneses()
for (i in 1:hb.size()) k[i] ~ dnPoisson(hb[i] + 1E-10)
z ~ dnUniform(0, 1)
for (pass in 1:2) {
    log = "output/successor_change_" + pass + ".log"
    # the resumed generation all but surely moves z alone
    w = ifelse(pass == 1, 1.0, 1E-12)
    mv = [ mvSlide(z, weight=1), mvSpeciationMode(x, symmetric=TRUE, weight=4*w) ]
    for (i in 1:hb.size()) mv.append( mvRandomNaturalWalk(k[i], weight=w) )
    m = mcmc(model(x, z), [ mnFile(filename=log, printgen=1, hb, ob, os, oa) ], mv, moveschedule="single")
    if (pass == 1) {
        m.run(generations=100, checkpointFile="output/successor_change.state", checkpointInterval=100)
        stopped = readTrace(log, burnin=0)
    } else {
        m.initializeFromCheckpoint("output/successor_change.state")
        m.run(generations=20)
        resumed = readTrace(log, burnin=0)
    }
}
same = TRUE
last = stopped[2].getValues().size()
for (j in 2:stopped.size()) {
    if (resumed[j].getValues()[1] != stopped[j].getValues()[last]) same = FALSE
}
print(filename=out, append=TRUE, same && stopped[2].getValues()[last] > -1E300, "\n")

print(filename=out, append=TRUE, "mvRotateNode still names the move:\n")
print(filename=out, append=TRUE, type(mvRotateNode(x)) == type(mvSpeciationMode(x)), "\n")

q()
