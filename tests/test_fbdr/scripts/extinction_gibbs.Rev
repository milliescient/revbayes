# mvExtinctionTimeGibbs draws an extended dnFBDSP tip's extinction from its conditional. A chain moving nothing
# else must keep every extinction between the present and its last appearance, and move each one. Every line
# printed must be TRUE.
seed(3)
taxa <- readTaxonData("data/fbdsp_symmetric.tsv")
out = "output/extinction_gibbs.txt"

x ~ dnFBDSP(taxa=taxa, lambda=0.8, mu=0.3, psi=0.5, rho=1.0, lambda_a=0.2, beta=0.4,
            origin=10.0, condition="time", extended=TRUE)
rec ~ dnFossilRecord(ranges=x, reporting="complete")
rec.clamp(taxa)
d := x.getExtinctionTimes()
la := x.getLastAppearances()
m = mcmc(model(x), [ mnFile(filename="output/extinction_gibbs.log", printgen=1, d) ], [ mvExtinctionTimeGibbs(x, weight=1) ])
m.run(generations=200)
trace = readTrace("output/extinction_gibbs.log", burnin=0)

within = TRUE
moved = TRUE
for (j in 1:la.size()) {
    vals = trace[4 + j].getValues()
    # a survivor stays at the present
    if (max(vals) > 0.0) {
        if (max(vals) > la[j] + 1E-12 || min(vals) <= 0.0) within = FALSE
        if (max(vals) == min(vals)) moved = FALSE
    }
}
print(filename=out, "every extinction stays between the present and its last appearance:\n")
print(filename=out, append=TRUE, within, "\n")
print(filename=out, append=TRUE, "and every one moves:\n")
print(filename=out, append=TRUE, moved, "\n")

q()
