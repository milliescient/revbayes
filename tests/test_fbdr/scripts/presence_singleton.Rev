# mvSingletonRJSwitch under reporting="presence". One occurrence reported over [3,4] may be one age, or a
# first and last appearance inside it. The move keeps tau_K = y and expands tau_1 above it or collapses
# it, so with only this move and the range fixed, the chain must split as often as
#
#   P(pair) / P(single) = int_y^4 p(o) psi e^(psi (o - y)) do / p(y)
#
# where p(t) is the density of a single age at t, and the pair's record adds psi e^(psi (o - y)) to it
# (presence.Rev checks that term). A lone dnFBDSP lineage scores its range the same way as a dnFBDRP,
# so its chain is held to the same ratio at its own death and tau_K. Every line printed must be TRUE.
seed(4)

taxa <- readTaxonData("data/fbdr_presence_single.tsv")

lambda <- 0.4
mu     <- 0.1
psi    <- 0.5
origin <- 20.0

out = "output/presence_singleton.txt"

bd ~ dnFBDRP(taxa=taxa, lambda=lambda, mu=mu, psi=psi, rho=1.0, present=0.0,
             condition="time", origin=origin)
rec ~ dnFossilRecord(ranges=bd, reporting="presence")
rec.clamp(taxa)

ext ~ dnFBDSP(taxa=taxa, lambda=lambda, mu=mu, psi=psi, rho=1.0, present=0.0,
              condition="time", origin=origin, extended=TRUE)
rec_ext ~ dnFossilRecord(ranges=ext, reporting="presence")
rec_ext.clamp(taxa)

death <- v(0.5, ext.getExtinctionTimes()[1])
last  <- v(3.5, ext.getLastAppearances()[1])

# Simpson over tau_1 in [y,4], from the dnFBDRP's single-age densities
n <- 200
for ( c in 1:2 )
{
    d <- death[c]
    y <- last[c]
    bd.setValue( matrix( v( v(d, y, y, origin) ) ) )
    single <- exp( bd.lnProbability() + rec.lnProbability() )
    pair <- 0.0
    for ( k in 0:n )
    {
        o <- y + (4.0 - y) * k / n
        w <- 2 + 2 * (k % 2)
        if ( k == 0 || k == n ) w <- 1
        bd.setValue( matrix( v( v(d, o, o, origin) ) ) )
        pair <- pair + w * exp( bd.lnProbability() + rec.lnProbability() ) * psi * exp( psi * (o - y) )
    }
    pair <- pair * (4.0 - y) / (3 * n)
    expected[c] <- pair / (single + pair)
}

bd.setValue( matrix( v( v(death[1], last[1], last[1], origin) ) ) )

split_bd  := 1 - bd.getSingletonStatus()[1]
split_ext := 1 - ext.getSingletonStatus()[1]

# each chain moves only the singleton status and tau_1
mymcmc = mcmc(model(bd), [ mnFile(split_bd, filename="output/presence_singleton_bd.log", printgen=10,
              posterior=FALSE, likelihood=FALSE, prior=FALSE) ], [ mvSingletonRJSwitch(bd, weight=1) ])
mymcmc.run(generations=200000)
observed[1] <- mean( readTrace("output/presence_singleton_bd.log", burnin=0)[2].getValues() )

mymcmc = mcmc(model(ext), [ mnFile(split_ext, filename="output/presence_singleton_ext.log", printgen=10,
              posterior=FALSE, likelihood=FALSE, prior=FALSE) ], [ mvSingletonRJSwitch(ext, weight=1) ])
mymcmc.run(generations=200000)
observed[2] <- mean( readTrace("output/presence_singleton_ext.log", burnin=0)[2].getValues() )

print(filename=out, "dnFBDRP splits a single occurrence as often as the record allows:\n")
print(filename=out, append=TRUE, abs(observed[1] - expected[1]) < 0.02, "\n")
print(filename=out, append=TRUE, "dnFBDSP splits a single occurrence as often as the record allows:\n")
print(filename=out, append=TRUE, abs(observed[2] - expected[2]) < 0.02, "\n")

q()
